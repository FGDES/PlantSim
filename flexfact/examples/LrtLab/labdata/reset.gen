%% add on to supervisor: reset and stop on depwp* events
<Generator>
"emergency reset"

<Alphabet>
"depwpar"  % sensor legft of cb 1
"depwplv"  % sensor legft of cb 1
"reset"    % actuator to stop all motors

% all other actuators
"sfmv"        "sfstp"       "pu1mv-y"     "pu1mv+y"     "pu1stp"      "pu2mv-y"     
"pu2mv+y"     "pu2stp"      "cb1+x"       "cb1-x"       "cb1stp"      "cb2-y"       
"cb2stp"      "cb3-y"       "cb3stp"      "cb4+x"       "cb4-x"       "cb4stp"      
"cb5+x"       "cb5-x"       "cb5stp"      "cb6+x"       "cb6-x"       "cb6stp"      
"cb7+y"       "cb7-y"       "cb7stp"      "cb8+y"       "cb8-y"       "cb8stp"      
"cb9+y"       "cb9-y"       "cb9stp"      "cb10+y"      "cb10-y"      "cb10stp"     
"cb11+x+y"    "cb11-x-y"    "cb11stp"     "cb12+x-y"    "cb12-x+y"    "cb12stp"     
"cb13+x-y"    "cb13-x+y"    "cb13stp"     "cb14+x-y"    "cb14-x+y"    "cb14stp"     
"cb15+y"      "cb15-y"      "cb15stp"     "cb16+y"      "cb16-y"      "cb16stp"     
"rt1mvy"      "rt1mvx"      "rt1stp"      "rt2mvy"      "rt2mvx"      "rt2stp"      
"rt3mvy"      "rt3mvx"      "rt3stp"      "rt4mvy"      "rt4mvx"      "rt4stp"      
"rts1+x"      "rts1-x"      "rts1stp"     "rts2+x"      "rts2-x"      "rts2stp"     
"mh1mv+z"     "mh1mv-z"     "mh1stp"      "mh2mv+z"     "mh2mv-z"     "mh2stp"      
"d1run"       "d1stp"       "d2run"       "d2stp"              
</Alphabet>

<States>
"Init"
"HaltA"
"HaltB"
</States>

<TransRel>
"Init" "depwpar" "HaltA"
"Init" "depwplv" "HaltA"
"HaltA" "reset" "HaltB"

%% selfloop all other actuators
"Init" "sfmv"        "Init" 
"Init" "sfstp"       "Init" 
"Init" "pu1mv-y"     "Init" 
"Init" "pu1mv+y"     "Init" 
"Init" "pu1stp"      "Init" 
