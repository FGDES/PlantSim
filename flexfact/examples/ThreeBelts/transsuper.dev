<SimplenetDevice name="Supervisor">
<TimeScale value="1000"/>
<ServerAddress value="localhost:40001"/>
<Network name="ThreeBelts">
<Node name="Plant"/>
<Node name="Supervisor"/>
</Network>
<EventConfiguration>
<Event name="cb1_wpar" iotype="input"/>
<Event name="cb1_wplv" iotype="input"/>
