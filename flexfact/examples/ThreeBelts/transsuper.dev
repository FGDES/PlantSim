<Event name="cb2_wplv" iotype="input"/>
<Event name="cb3_wpar" iotype="input"/>
<Event name="cb3_wplv" iotype="input"/>
<Event name="sf_fdhome" iotype="input"/>
<Event name="sf_wpar" iotype="input"/>
<Event name="sf_wplv" iotype="input"/>
<Event name="xs_wpar" iotype="input"/>
<Event name="xs_wplv" iotype="input"/>
<Event name="cb1_bm+" iotype="output"/>
<Event name="cb1_bm-" iotype="output"/>
<Event name="cb1_boff" iotype="output"/>
<Event name="cb2_bm+" iotype="output"/>
<Event name="cb2_bm-" iotype="output"/>
<Event name="cb2_boff" iotype="output"/>
<Event name="cb3_bm+" iotype="output"/>
<Event name="cb3_bm-" iotype="output"/>
<Event name="cb3_boff" iotype="output"/>
